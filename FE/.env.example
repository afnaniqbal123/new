# Copy to `.env.local` and adjust per environment. Never commit real secrets.

# Host for the API client (src/services/api-client.ts). Leave empty for same-origin.
# Point it at the BusinessOS backend to run against real data:
#   VITE_API_BASE_URL=http://127.0.0.1:8080
# Route paths in src/constants/common.ts are already absolute (e.g. "/sales"),
# so this is host-only — do not add a trailing "/api/v1" or similar here.
VITE_API_BASE_URL=

# Toggle the MSW mocked network in dev. `true` keeps the app runnable with no
# backend at all (fixed, obviously-fake figures — see src/mocks/handlers.ts).
# Set `false` in .env.local to talk to the real API.
VITE_ENABLE_MOCKS=true

# Internal — set only by .env.e2e (via `pnpm build:e2e`), never by hand or in a
# real deploy. Leave unset here; see src/constants/env.ts and playwright.config.ts.
VITE_E2E=

# Development only. How the seeded demo team's addresses are spelled, with
# `{role}` standing in for owner/admin/manager/cashier/accountant/viewer.
# Powers the one-click role buttons on the sign-in screen; they are stripped
# from production builds entirely. Change it if you pointed `BE/pnpm seed:demo`
# at a real mailbox, e.g. `you+{role}@yourdomain.com`.
VITE_DEMO_EMAIL_PATTERN={role}@kolachi.test
