{
  "name": "businessos-api",
  "version": "0.0.1",
  "description": "BusinessOS \u2014 AI-powered operations platform for distributors and small retail chains.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "nest build",
    "prepare": "husky",
    "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
    "lint:check": "eslint '{src,test}/**/*.ts' --max-warnings=0",
    "lint:baseline": "eslint '{src,test}/**/*.ts' --suppress-all",
    "lint:baseline:prune": "eslint '{src,test}/**/*.ts' --prune-suppressions",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/hooks/pre-commit.mjs --all",
    "debt": "node scripts/hooks/debt-report.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "pnpm run start:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "test:e2e:auth": "jest --config ./test/jest-e2e.json test/auth",
    "architecture:check": "node scripts/architecture/check.mjs",
    "architecture:baseline": "node scripts/architecture/check.mjs --update",
    "architecture:test": "node --test scripts/architecture/rules.spec.mjs",
    "architecture:accept": "node scripts/architecture/check.mjs --update --accept-new",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:test": "node --test scripts/docs/check.spec.mjs",
    "toolkit:test": "node --test scripts/export-toolkit.spec.mjs",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@casl/ability": "^7.0.1",
    "@getbrevo/brevo": "^6.0.2",
    "@google/genai": "^1.34.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.4.7",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.7.0",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mongoose": "^9.9.4",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.16",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0 --pass-on-unpruned-suppressions --format ./scripts/hooks/eslint-reporter.mjs",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
